    "securitySchemes": {
      "CalculatePensionApiKey": {
        "type": "apiKey",
        "description": "Khóa bí mật dùng cho GPT Action, gửi qua header X-API-Key.",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "servers": [
    {
      "url": "https://calculatepension-api.onrender.com"
    }
  ]
}
