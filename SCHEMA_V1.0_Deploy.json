        "additionalProperties": false,
        "type": "object",
        "required": [
          "calculation",
          "identity",
          "total_months",
          "average_salary",
          "replacement_rate",
          "rate_before_early_reduction",
          "contribution_month_remainder_rate",
          "early_retirement_months",
          "early_retirement_reduction",
          "rate_after_reduction",
          "estimated_pension"
        ],
        "title": "PensionCalculationResponse"
      },
      "Person": {
        "properties": {
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "title": "Date Of Birth"
          },
          "sex": {
            "$ref": "#/components/schemas/Sex"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date_of_birth",
          "sex"
        ],
        "title": "Person"
      },
      "RetirementCase": {
        "type": "string",
        "enum": [
          "normal",
          "hazardous_or_special_region",
          "underground_coal",
          "reduced_capacity"
        ],
        "title": "RetirementCase"
      },
      "RetirementPolicy": {
        "type": "string",
        "enum": [
          "none",
          "decree_154_streamlining",
          "other_special_policy"
        ],
        "title": "RetirementPolicy"
      },
      "SBHComponents": {
        "properties": {
          "unit": {
            "$ref": "#/components/schemas/SbhComponentUnit"
          },
          "base_value": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Base Value"
          },
          "position_allowance": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Position Allowance",
            "default": "0"
          },
          "seniority_beyond_frame_allowance": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Seniority Beyond Frame Allowance",
            "default": "0"
          },
          "professional_seniority_allowance": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Professional Seniority Allowance",
            "default": "0"
          },
          "regional_allowance": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Regional Allowance",
            "default": "0"
          },
          "other_allowance": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Other Allowance",
            "default": "0"
          },
          "reelection_allowance": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Reelection Allowance",
            "default": "0"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "unit",
          "base_value"
        ],
        "title": "SBHComponents"
      },
      "SbhComponentUnit": {
        "type": "string",
        "enum": [
          "coefficient",
          "vnd"
        ],
        "title": "SbhComponentUnit"
      },
      "Sex": {
        "type": "string",
        "enum": [
          "male",
          "female"
        ],
        "title": "Sex"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ValidationResponse": {
        "properties": {
          "validation": {
            "type": "boolean",
            "title": "Validation"
          },
          "normalized_summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NormalizedSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "validation"
        ],
        "title": "ValidationResponse"
      }
