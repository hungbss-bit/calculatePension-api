{
  "openapi": "3.1.0",
  "info": {
    "title": "calculatePension API",
    "description": "API dự tính lương hưu BHXH Việt Nam V1.0, bao gồm trợ cấp một lần khi nghỉ hưu. Kết quả chỉ mang tính ước tính.",
    "version": "1.0.10"
  },
  "paths": {
    "/v1/validateContributionHistory": {
      "post": {
        "summary": "Kiểm tra và chuẩn hóa lịch sử đóng BHXH",
        "operationId": "validateContributionHistory",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PensionCalculationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "CalculatePensionApiKey": []
          }
        ]
      }
    },
    "/v1/calculatePension": {
      "post": {
        "summary": "Tính dự tính lương hưu và trợ cấp một lần",
        "operationId": "calculatePension",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PensionCalculationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PensionCalculationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "CalculatePensionApiKey": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AverageExclusionReason": {
        "type": "string",
        "enum": [
          "pre1995_policy"
        ],
        "title": "AverageExclusionReason"
      },
      "AverageInclusion": {
        "type": "string",
        "enum": [
          "included",
          "excluded"
        ],
        "title": "AverageInclusion"
      },
      "BasisInputType": {
        "type": "string",
        "enum": [
          "mau_07_sbh_components",
          "monthly_basis_vnd"
        ],
        "title": "BasisInputType"
      },
      "BenefitCalculationScope": {
        "type": "string",
        "enum": [
          "pension_only",
          "pension_and_one_time_allowance"
        ],
        "title": "BenefitCalculationScope"
      },
      "CalculationIdentity": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "so_bhxh": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
