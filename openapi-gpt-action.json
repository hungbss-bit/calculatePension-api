          }
        },
        "type": "object",
        "required": [
          "code",
          "severity",
          "message_vi"
        ],
        "title": "HistoryIssue"
      },
      "HistoryValidationResult": {
        "properties": {
          "valid_for_calculation": {
            "type": "boolean",
            "title": "Valid For Calculation"
          },
          "total_unique_months": {
            "type": "integer",
            "title": "Total Unique Months",
