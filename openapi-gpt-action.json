        ],
        "title": "ParticipationStatus"
      },
      "PensionRateResult": {
        "properties": {
          "rounded_years": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
