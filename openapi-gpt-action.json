              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Required Compulsory Months"
          },
          "months_short": {
            "type": "integer",
            "title": "Months Short",
            "default": 0
          },
          "can_pay_missing_months_once": {
            "type": "boolean",
            "title": "Can Pay Missing Months Once",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "eligible",
          "case"
        ],
        "title": "EligibilityResult"
      },
      "GapPeriod": {
        "properties": {
          "from_month": {
            "type": "string",
            "title": "From Month"
          },
          "to_month": {
            "type": "string",
            "title": "To Month"
          },
          "months": {
            "type": "integer",
            "title": "Months"
          }
        },
        "type": "object",
        "required": [
          "from_month",
          "to_month",
          "months"
        ],
        "title": "GapPeriod"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
