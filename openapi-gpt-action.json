{
  "openapi": "3.1.0",
  "info": {
    "title": "API calculatePension - Tính lương hưu BHXH",
    "description": "API dự tính lương hưu BHXH Việt Nam, hỗ trợ dữ liệu chuẩn hóa từ Mẫu 07/SBH, kiểm tra tháng trống/trùng, trạng thái không tham gia, thời gian chỉ cộng thời gian, quá trình hỗn hợp và bộ hệ số theo năm hưởng. Kết quả chỉ mang tính tham khảo.",
    "contact": {
      "name": "Quản trị viên calculatePension"
    },
    "version": "2.1.0"
  },
  "paths": {
    "/v1/capabilities": {
      "get": {
        "tags": [
          "Hệ thống"
        ],
        "summary": "Xem phạm vi tính toán hiện được hỗ trợ",
        "operationId": "getPensionCapabilities",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/v1/validateContributionHistory": {
      "post": {
        "tags": [
          "Kiểm tra hồ sơ"
        ],
        "summary": "Kiểm tra dữ liệu quá trình BHXH trước khi tính",
        "description": "Kiểm tra xác nhận Mẫu 07/SBH, đơn vị mức đóng, tháng trống, tháng trùng và giai đoạn sau tháng bắt đầu hưởng.",
        "operationId": "validateContributionHistory",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PensionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryValidationResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/v1/calculatePension": {
      "post": {
        "tags": [
          "Tính lương hưu"
        ],
        "summary": "Dự tính mức lương hưu",
        "description": "Tính điều kiện hưởng, mức bình quân, tỷ lệ, giảm do nghỉ trước tuổi, lương hưu dự tính và trợ cấp một lần. Dữ liệu Mẫu 07/SBH phải được chuẩn hóa và xác nhận trước.",
        "operationId": "calculatePension",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PensionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PensionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AdjustmentInput": {
        "properties": {
          "coefficient_year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 2025.0,
            "title": "Coefficient Year",
            "default": 2026
          },
          "salary_coefficients": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0.0
                    },
                    {
                      "type": "string",
                      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Salary Coefficients"
          },
          "voluntary_income_coefficients": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0.0
                    },
                    {
                      "type": "string",
                      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voluntary Income Coefficients"
          }
        },
        "type": "object",
        "title": "Bộ hệ số điều chỉnh"
      },
      "AverageBasisResult": {
        "properties": {
          "amount_vnd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount Vnd",
            "description": "Trường tương thích ngược; bằng average_monthly_basis_vnd."
          },
          "average_monthly_basis_vnd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Average Monthly Basis Vnd",
            "description": "Mức bình quân tiền lương/thu nhập làm căn cứ đóng BHXH trước khi nhân tỷ lệ hưởng."
          },
          "basis_months_used": {
            "type": "integer",
            "title": "Basis Months Used",
            "description": "Số tháng dữ liệu tiền lương/thu nhập trực tiếp dùng trong phép bình quân.",
            "default": 0
          },
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Method"
          },
          "coefficient_year": {
            "type": "integer",
            "title": "Coefficient Year"
          },
          "state_average_months_used": {
            "type": "integer",
            "title": "State Average Months Used",
            "default": 0
          },
          "yearly_breakdown": {
            "items": {
              "$ref": "#/components/schemas/YearlyAdjustmentBreakdown"
            },
            "type": "array",
            "title": "Yearly Breakdown"
          }
        },
        "type": "object",
        "required": [
          "amount_vnd",
          "average_monthly_basis_vnd",
          "method",
          "coefficient_year"
        ],
        "title": "AverageBasisResult"
      },
      "BasisComponents": {
        "properties": {
          "main_salary_vnd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Main Salary Vnd"
          },
          "salary_allowance_vnd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Salary Allowance Vnd"
          },
          "other_supplement_vnd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Other Supplement Vnd"
          }
        },
        "type": "object",
        "title": "Các thành phần làm căn cứ đóng"
      },
      "BasisInputType": {
        "type": "string",
        "enum": [
          "total_vnd",
          "converted_state_vnd",
          "component_sum_vnd",
          "salary_coefficient",
          "unknown"
        ],
        "title": "BasisInputType"
      },
      "CapabilitiesResponse": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "legal_rule_version": {
            "type": "string",
            "title": "Legal Rule Version"
          },
          "built_in_coefficient_years": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Built In Coefficient Years"
          },
          "supported_retirement_cases": {
            "items": {
              "$ref": "#/components/schemas/RetirementCase"
            },
            "type": "array",
            "title": "Supported Retirement Cases"
          },
          "manual_review_cases": {
            "items": {
              "$ref": "#/components/schemas/RetirementCase"
            },
            "type": "array",
            "title": "Manual Review Cases"
          },
          "supported_source_documents": {
            "items": {
              "$ref": "#/components/schemas/SourceDocumentType"
            },
            "type": "array",
            "title": "Supported Source Documents"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "service",
          "version",
          "legal_rule_version",
          "built_in_coefficient_years",
          "supported_retirement_cases",
          "manual_review_cases",
          "supported_source_documents",
          "notes"
        ],
        "title": "CapabilitiesResponse"
      },
      "ConfirmationStatus": {
        "type": "string",
        "enum": [
          "confirmed",
          "unconfirmed",
          "unclear"
        ],
        "title": "ConfirmationStatus"
      },
      "ContributionPeriod": {
        "properties": {
          "from_month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "title": "Từ tháng"
          },
          "to_month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "title": "Đến tháng"
          },
          "participation_status": {
            "$ref": "#/components/schemas/ParticipationStatus",
            "title": "Trạng thái tham gia",
            "description": "contributed = có đóng và dùng tính thời gian, mức bình quân; credited_duration_only = chỉ cộng thời gian, không dùng mức lương; not_participating = không tham gia, loại khỏi toàn bộ phép tính.",
            "default": "contributed"
          },
          "duration_only_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DurationOnlyReason"
              },
              {
                "type": "null"
              }
            ],
            "title": "Căn cứ chỉ cộng thời gian",
            "description": "Bắt buộc khi participation_status = credited_duration_only. Hiện API chỉ hỗ trợ thời gian trước 01/01/1995 được công nhận nhưng không hưởng tiền lương hoặc sinh hoạt phí."
          },
          "monthly_basis_vnd": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tổng mức làm căn cứ đóng (đồng/tháng)",
            "description": "Chỉ bắt buộc với trạng thái contributed; phải là VND, không phải hệ số thô."
          },
          "contribution_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ContributionType"
              },
              {
                "type": "null"
              }
            ],
            "title": "Loại quá trình đóng",
            "description": "Không bắt buộc khi participation_status = not_participating."
          },
          "basis_input_type": {
            "$ref": "#/components/schemas/BasisInputType",
            "title": "Kiểu dữ liệu mức đóng",
            "default": "total_vnd"
          },
          "basis_components": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BasisComponents"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Giá trị đọc từ hồ sơ",
            "description": "Dùng kiểm toán Mẫu 07/SBH; không tự dùng để tính nếu chưa chuẩn hóa."
          },
          "source_unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Unit"
          },
          "source_row_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Row Id"
          },
          "source_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Text"
          },
          "confirmation_status": {
            "$ref": "#/components/schemas/ConfirmationStatus",
            "default": "confirmed"
          },
          "coefficient_override": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coefficient Override"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "qualifying_hazardous": {
            "type": "boolean",
            "title": "Qualifying Hazardous",
            "default": false
          },
          "qualifying_especially_hazardous": {
            "type": "boolean",
            "title": "Qualifying Especially Hazardous",
            "default": false
          },
          "qualifying_underground_coal": {
            "type": "boolean",
            "title": "Qualifying Underground Coal",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "from_month",
          "to_month"
        ],
        "title": "Giai đoạn trong quá trình BHXH"
      },
      "ContributionSummary": {
        "properties": {
          "total_months": {
            "type": "integer",
            "title": "Total Months"
          },
          "compulsory_months": {
            "type": "integer",
            "title": "Compulsory Months"
          },
          "voluntary_months": {
            "type": "integer",
            "title": "Voluntary Months"
          },
          "average_basis_months": {
            "type": "integer",
            "title": "Average Basis Months",
            "default": 0
          },
          "credited_duration_only_months": {
            "type": "integer",
            "title": "Credited Duration Only Months",
            "default": 0
          },
          "excluded_non_participation_months": {
            "type": "integer",
            "title": "Excluded Non Participation Months",
            "default": 0
          },
          "exact_duration": {
            "type": "string",
            "title": "Exact Duration"
          },
          "rounded_years_for_rate": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Rounded Years For Rate"
          }
        },
        "type": "object",
        "required": [
          "total_months",
          "compulsory_months",
          "voluntary_months",
          "exact_duration",
          "rounded_years_for_rate"
        ],
        "title": "ContributionSummary"
      },
      "ContributionType": {
