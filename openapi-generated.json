{
  "openapi": "3.1.0",
  "info": {
    "title": "API tính lương hưu BHXH",
    "description": "Công cụ dự tính lương hưu cho người tham gia bảo hiểm xã hội Việt Nam theo Luật Bảo hiểm xã hội năm 2024 và các quy định triển khai hiện hành. Kết quả chỉ mang tính tham khảo; hồ sơ được cơ quan BHXH xác nhận là căn cứ cuối cùng.",
    "contact": {
      "name": "Quản trị viên API calculatePension"
    },
    "version": "1.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Hệ thống"
        ],
        "summary": "Kiểm tra trạng thái API",
        "description": "Kiểm tra nhanh dịch vụ calculatePension có đang hoạt động hay không.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Trạng thái hoạt động của dịch vụ.",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/calculatePension": {
      "post": {
        "tags": [
          "Tính lương hưu"
        ],
        "summary": "Dự tính mức lương hưu",
        "description": "Tính điều kiện hưởng, mức bình quân làm căn cứ, tỷ lệ hưởng, lương hưu dự kiến và trợ cấp một lần dựa trên dữ liệu người dùng cung cấp. Không được tự suy đoán dữ liệu còn thiếu.",
        "operationId": "calculatePension",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/YeuCauTinhLuongHuu"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kết quả dự tính lương hưu và các cảnh báo liên quan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KetQuaTinhLuongHuu"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoiKiemTraDuLieu"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DuLieuDieuChinh": {
        "properties": {
          "coefficient_year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 2025.0,
            "title": "Năm áp dụng hệ số",
            "description": "Năm của bộ hệ số điều chỉnh tiền lương và thu nhập đóng BHXH. Ứng dụng tích hợp sẵn bộ hệ số năm 2026.",
            "default": 2026,
            "examples": [
              2026
            ]
          },
          "salary_coefficients": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0.0
                    },
                    {
                      "type": "string",
                      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bảng hệ số tiền lương",
            "description": "Bảng hệ số điều chỉnh tiền lương theo năm đóng. Chỉ cần cung cấp khi tính cho năm chưa được tích hợp sẵn."
          },
          "voluntary_income_coefficients": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0.0
                    },
                    {
                      "type": "string",
                      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bảng hệ số thu nhập BHXH tự nguyện",
            "description": "Bảng hệ số điều chỉnh thu nhập đóng BHXH tự nguyện theo năm đóng."
          }
        },
        "type": "object",
        "title": "Dữ liệu điều chỉnh"
      },
      "KetQuaMucBinhQuan": {
        "properties": {
          "amount_vnd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mức bình quân, đồng"
          },
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phương pháp tính mức bình quân"
          },
          "coefficient_year": {
            "type": "integer",
            "title": "Năm của bộ hệ số điều chỉnh"
          },
          "state_average_months_used": {
            "type": "integer",
            "title": "Số tháng khu vực Nhà nước dùng để bình quân",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "amount_vnd",
          "method",
          "coefficient_year"
        ],
        "title": "Kết quả mức bình quân"
      },
      "GiaiDoanDongBHXH": {
        "properties": {
          "from_month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "title": "Từ tháng",
            "description": "Tháng bắt đầu của giai đoạn đóng, định dạng YYYY-MM; tính cả tháng này.",
            "examples": [
              "1996-10"
            ]
          },
          "to_month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "title": "Đến tháng",
            "description": "Tháng kết thúc của giai đoạn đóng, định dạng YYYY-MM; tính cả tháng này.",
            "examples": [
              "2026-09"
            ]
          },
          "monthly_basis_vnd": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Mức đóng hằng tháng",
            "description": "Tiền lương hoặc thu nhập tháng làm căn cứ đóng BHXH, đơn vị đồng Việt Nam.",
            "examples": [
              10800000
            ]
          },
          "contribution_type": {
            "$ref": "#/components/schemas/LoaiHinhDongBHXH",
            "title": "Loại quá trình đóng",
            "description": "compulsory_state = lương do Nhà nước quy định; compulsory_employer = lương do người sử dụng lao động quyết định; voluntary = BHXH tự nguyện.",
            "examples": [
              "compulsory_employer"
            ]
          },
          "coefficient_override": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hệ số điều chỉnh riêng",
            "description": "Không bắt buộc. Chỉ nhập khi có hệ số chính thức cần áp dụng riêng cho toàn bộ giai đoạn này.",
            "examples": [
              1
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ghi chú",
            "description": "Thông tin giải thích thêm về giai đoạn đóng BHXH."
          }
        },
        "type": "object",
        "required": [
          "from_month",
          "to_month",
          "monthly_basis_vnd",
          "contribution_type"
        ],
        "title": "Giai đoạn đóng BHXH"
      },
      "TongHopThoiGianDong": {
        "properties": {
          "total_months": {
            "type": "integer",
            "title": "Tổng số tháng đóng"
          },
          "compulsory_months": {
            "type": "integer",
            "title": "Số tháng BHXH bắt buộc"
          },
          "voluntary_months": {
            "type": "integer",
            "title": "Số tháng BHXH tự nguyện"
          },
          "exact_duration": {
            "type": "string",
            "title": "Thời gian đóng thực tế"
          },
          "rounded_years_for_rate": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Số năm sau khi làm tròn để tính tỷ lệ"
          }
        },
        "type": "object",
        "required": [
          "total_months",
          "compulsory_months",
          "voluntary_months",
          "exact_duration",
          "rounded_years_for_rate"
        ],
        "title": "Tổng hợp thời gian đóng"
      },
      "LoaiHinhDongBHXH": {
        "type": "string",
        "enum": [
          "compulsory_state",
          "compulsory_employer",
          "voluntary"
        ],
        "title": "ContributionType",
        "description": "Loại tiền lương hoặc thu nhập làm căn cứ đóng BHXH."
      },
      "KetQuaDieuKienHuong": {
        "properties": {
          "eligible": {
            "type": "boolean",
            "title": "Đủ điều kiện hưởng"
          },
          "case": {
            "$ref": "#/components/schemas/TruongHopNghiHuu",
            "title": "Trường hợp nghỉ hưu đã xét"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Lý do",
            "description": "Các lý do chưa đủ điều kiện hoặc cần kiểm tra thêm."
          },
          "missing_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dữ liệu còn thiếu"
          }
        },
        "type": "object",
        "required": [
          "eligible",
          "case"
        ],
        "title": "Kết quả điều kiện hưởng"
      },
      "LoiKiemTraDuLieu": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ChiTietLoiDuLieu"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KetQuaTyLeHuong": {
        "properties": {
          "base_rate_percent": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tỷ lệ hưởng cơ bản, %"
          },
          "early_retirement_reduction_percent": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Tỷ lệ giảm do nghỉ hưu trước tuổi, %"
          },
          "final_rate_percent": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tỷ lệ hưởng cuối cùng, %"
          }
        },
        "type": "object",
        "required": [
          "base_rate_percent",
          "early_retirement_reduction_percent",
          "final_rate_percent"
        ],
        "title": "Kết quả tỷ lệ hưởng"
      },
      "YeuCauTinhLuongHuu": {
        "properties": {
          "person": {
            "$ref": "#/components/schemas/ThongTinCaNhan",
            "title": "Thông tin người lao động",
            "description": "Ngày sinh và giới tính của người cần dự tính lương hưu."
          },
          "pension_start_month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "title": "Tháng bắt đầu hưởng lương hưu",
            "description": "Tháng đầu tiên dự kiến nhận lương hưu, định dạng YYYY-MM. Ứng dụng hiểu ngày nghỉ việc là ngày cuối cùng của tháng trước đó.",
            "examples": [
              "2026-10"
            ]
          },
          "retirement_case": {
            "$ref": "#/components/schemas/TruongHopNghiHuu",
            "title": "Trường hợp nghỉ hưu",
            "description": "normal = nghỉ đúng điều kiện thông thường; hazardous_or_special_region = nghề nặng nhọc hoặc vùng đặc biệt; underground_coal = khai thác than hầm lò; reduced_capacity = suy giảm khả năng lao động; occupational_hiv và armed_forces được chuyển sang kiểm tra thủ công.",
            "default": "normal"
          },
          "contributions": {
            "items": {
              "$ref": "#/components/schemas/GiaiDoanDongBHXH"
            },
            "type": "array",
            "minItems": 1,
            "title": "Quá trình tham gia BHXH",
            "description": "Danh sách các giai đoạn đóng BHXH. Các giai đoạn không được trùng tháng."
          },
          "impairment_percent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tỷ lệ suy giảm khả năng lao động",
            "description": "Chỉ nhập đối với trường hợp nghỉ hưu do suy giảm khả năng lao động.",
            "examples": [
              81
            ]
          },
          "hazardous_or_special_region_months": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Số tháng nghề nặng nhọc hoặc vùng đặc biệt",
            "description": "Tổng số tháng thuộc nhóm nghề, công việc hoặc địa bàn đủ điều kiện.",
            "default": 0
          },
          "especially_hazardous_months": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Số tháng nghề đặc biệt nặng nhọc",
            "description": "Tổng số tháng làm nghề hoặc công việc đặc biệt nặng nhọc, độc hại, nguy hiểm.",
            "default": 0
          },
          "underground_coal_months": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Số tháng khai thác than hầm lò",
            "description": "Tổng số tháng làm công việc khai thác than trong hầm lò.",
            "default": 0
          },
          "state_salary_values_are_converted": {
            "type": "boolean",
            "title": "Tiền lương Nhà nước đã được quy đổi",
            "description": "Đặt true chỉ khi các mức lương khu vực Nhà nước trước năm 2016 đã được quy đổi đúng theo quy định về mức tham chiếu hoặc thang bảng lương.",
            "default": false
          },
          "reference_level_vnd": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mức tham chiếu",
            "description": "Mức tham chiếu bằng đồng dùng để kiểm tra mức lương hưu tối thiểu trong trường hợp chuyển tiếp, nếu có."
          },
          "adjustment": {
            "$ref": "#/components/schemas/DuLieuDieuChinh",
            "title": "Thông tin hệ số điều chỉnh"
          }
        },
        "type": "object",
        "required": [
          "person",
          "pension_start_month",
          "contributions"
        ],
        "title": "Yêu cầu tính lương hưu",
        "examples": [
          {
            "adjustment": {
              "coefficient_year": 2026
            },
            "contributions": [
              {
                "contribution_type": "compulsory_employer",
                "from_month": "1996-10",
                "monthly_basis_vnd": 10800000,
                "to_month": "2026-09"
              }
            ],
            "pension_start_month": "2026-10",
            "person": {
              "date_of_birth": "1969-09-01",
              "sex": "female"
            },
            "retirement_case": "normal"
          }
        ]
      },
      "KetQuaTinhLuongHuu": {
        "properties": {
          "calculation_id": {
            "type": "string",
            "title": "Mã lần tính"
          },
          "status": {
            "type": "string",
            "title": "Trạng thái kết quả",
            "description": "eligible = đủ điều kiện; not_eligible = chưa đủ điều kiện; needs_more_data = cần bổ sung dữ liệu; manual_review = cần kiểm tra thủ công."
          },
          "legal_rule_version": {
            "type": "string",
            "title": "Phiên bản bộ quy tắc pháp lý"
          },
          "requested_pension_start_month": {
            "type": "string",
            "title": "Tháng hưởng đã yêu cầu"
          },
          "retirement_end_date": {
            "type": "string",
            "format": "date",
            "title": "Ngày kết thúc làm việc hoặc nghỉ hưu"
          },
          "normal_retirement_age": {
            "type": "string",
            "title": "Tuổi nghỉ hưu thông thường"
          },
          "normal_retirement_threshold_date": {
            "type": "string",
            "format": "date",
            "title": "Ngày đạt tuổi nghỉ hưu thông thường"
          },
          "earliest_normal_pension_start_month": {
            "type": "string",
            "title": "Tháng sớm nhất hưởng theo diện thông thường"
          },
          "contribution_summary": {
            "$ref": "#/components/schemas/TongHopThoiGianDong",
            "title": "Tổng hợp quá trình đóng"
          },
          "eligibility": {
            "$ref": "#/components/schemas/KetQuaDieuKienHuong",
            "title": "Kết quả xét điều kiện"
          },
          "average_basis": {
            "$ref": "#/components/schemas/KetQuaMucBinhQuan",
            "title": "Mức bình quân làm căn cứ"
          },
          "pension_rate": {
            "$ref": "#/components/schemas/KetQuaTyLeHuong",
            "title": "Tỷ lệ hưởng lương hưu"
          },
          "estimated_monthly_pension_vnd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lương hưu dự kiến hằng tháng, đồng"
          },
          "one_time_retirement_allowance_vnd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trợ cấp một lần khi nghỉ hưu, đồng"
          },
          "minimum_floor_applied": {
            "type": "boolean",
            "title": "Đã áp dụng mức lương hưu tối thiểu",
            "default": false
          },
          "assumptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Các giả định"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Các cảnh báo"
          },
          "audit_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Các bước kiểm tra phép tính"
          }
        },
        "type": "object",
        "required": [
          "calculation_id",
          "status",
          "legal_rule_version",
          "requested_pension_start_month",
          "retirement_end_date",
          "normal_retirement_age",
          "normal_retirement_threshold_date",
          "earliest_normal_pension_start_month",
          "contribution_summary",
          "eligibility",
          "average_basis",
          "pension_rate",
          "estimated_monthly_pension_vnd",
          "one_time_retirement_allowance_vnd"
        ],
